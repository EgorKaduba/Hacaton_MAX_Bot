# Скопируйте в .env.local и поменяйте нужное. Без файла работают значения по умолчанию.

# Адрес API. По умолчанию /api — через прокси Vite на BACKEND_URL.
# Пустое значение (VITE_API_URL=) — мок-данные из src/api/mock.js, бэкенд не нужен.
VITE_API_URL=/api

# Куда прокси Vite пересылает запросы /api (для npm run dev и npm run preview)
BACKEND_URL=http://127.0.0.1:8000

# max_user_id при запуске в обычном браузере; внутри MAX берётся id пользователя из MAX Bridge
VITE_DEV_MAX_USER_ID=1
